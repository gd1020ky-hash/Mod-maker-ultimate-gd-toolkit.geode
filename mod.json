{
  "geode": "5.10.1",
  "gd": { "android": "2.2081" },
  "id": "you.gdtoolkit",
  "name": "GD Toolkit",
  "version": "v1.0.0",
  "developer": "you",
  "description": "Macro, frame counter, speed, auto deco, AI build",
  "settings": {
    "macro-mode": { "type": "string", "default": "off", "one-of": ["off", "record", "play"], "name": "Macro mode" },
    "speed": { "type": "float", "default": 1.0, "min": 0.1, "max": 5.0, "control": { "slider": true }, "name": "Speed" },
    "sync-music": { "type": "bool", "default": true, "name": "Sync music speed" },
    "show-frames": { "type": "bool", "default": true, "name": "Frame counter" },
    "click-sound": { "type": "bool", "default": false, "name": "Click sound" },
    "sound-file": { "type": "string", "default": "", "name": "Sound path (absolute)" },
    "deco-id": { "type": "int", "default": 211, "name": "Auto deco object ID" },
    "api-key": { "type": "string", "default": "", "name": "Anthropic API key" },
    "model": { "type": "string", "default": "claude-sonnet-5-5", "name": "AI model" }
  }
}
